# Copy to .env and fill in real values. Never commit .env.

# --- AI and travel APIs ---
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Optional Gemini models (defaults: gemini-3.5-flash for the coordinator,
# gemini-3.5-flash-lite for the specialist sub-agents)
TRAVEL_AGENT_MODEL=
TRAVEL_SPECIALIST_MODEL=
# Tried in order when a model is overloaded (503) or out of quota (429), comma-separated
# (defaults: gemini-3.8-flash,gemini-3.6-flash / gemini-3.1-flash-lite)
TRAVEL_AGENT_FALLBACK_MODELS=
TRAVEL_SPECIALIST_FALLBACK_MODELS=
LITEAPI_KEY=
GEOAPIFY_API_KEY=
# Open-Meteo needs no key

# --- API server ---
# development enables /docs and POST /api/auth/dev-token; production disables both
APP_ENV=development
# Leave empty to use a local SQLite file (backend/travel_planner.db).
# PostgreSQL from docker-compose.yml:
#   DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel_planner
DATABASE_URL=
# Sign-in tokens from the frontend (Better Auth). Leave AUTH_JWKS_URL empty to accept only dev tokens.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=travel-planner-api
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty in development = a temporary secret (tokens stop working after a restart).
JWT_SECRET=
# Frontend origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:3000
# Per user. One planning message uses ~10 Gemini requests.
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=40
