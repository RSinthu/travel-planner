# Copy to .env and fill in real values. Never commit .env.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Optional Gemini models (defaults: gemini-3.5-flash for the coordinator,
# gemini-3.5-flash-lite for the specialist sub-agents)
TRAVEL_AGENT_MODEL=
TRAVEL_SPECIALIST_MODEL=
LITEAPI_KEY=
GEOAPIFY_API_KEY=
# Open-Meteo needs no key
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/travel_planner
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=
