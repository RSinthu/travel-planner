# Signs sessions and keys; at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Where this app runs (also the issuer of the API tokens)
BETTER_AUTH_URL=http://localhost:3000
# User accounts database (SQLite file, relative to frontend/)
AUTH_DATABASE_PATH=auth.sqlite
# The FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8080

